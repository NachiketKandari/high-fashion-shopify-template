# Required
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN="your-storefront-access-token-here"
NEXT_PUBLIC_SHOPIFY_SHOP_ID="123456789"

# Required while auth.isEnabled is true, which is the default.
# CUSTOMER_ACCOUNT_SESSION_SECRET="your-session-secret-here" # App-generated secret, not the Shopify client secret.
# SHOPIFY_CUSTOMER_ACCOUNT_API_CLIENT_ID="00000000-0000-0000-0000-000000000000"
# SHOPIFY_CUSTOMER_ACCOUNT_API_CLIENT_SECRET="your-customer-account-client-secret-here"

# Optional
# AI_GATEWAY_API_KEY="your-ai-gateway-api-key-here" # Shop Agent model access outside Vercel OIDC, such as local development without vercel env pull.
# DEBUG_SHOPIFY="1" # Log Shopify API operation timings and debug messages as plain console text.
# NEXT_PUBLIC_SITE_URL="https://your-domain.example" # Canonical public URL for metadata, sitemaps and robots; defaults to the Vercel production URL.
# NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX" # Set to load the Google Analytics tag directly; leave unset when NEXT_PUBLIC_GTM_ID sends GA4 through Tag Manager.
# NEXT_PUBLIC_GTM_ID="GTM-XXXXXX" # Set to load Google Tag Manager; the GA4 tag then comes from the container instead of the direct tag.
# NEXT_PUBLIC_SHOPIFY_STOREFRONT_ID="123456789"
# REVALIDATE_SECRET="your-revalidate-secret-here" # Set to refresh content Shopify sends no webhook for, such as pages, policies, blogs, and articles; send it as a Bearer token to POST /api/revalidate.
# REVALIDATE_URL="https://your-store.example/api/revalidate" # With `pnpm seed:content`, revalidate page and article tags after a seed.
# SHOPIFY_API_VERSION="2026-10" # Override the Storefront API version, which defaults to the version Hydrogen targets.
# Dev Dashboard app credentials for `pnpm seed:catalog`, `pnpm import:catalog`, and `pnpm seed:content`; tokens are exchanged at run time and expire after 24 hours.
# SHOPIFY_CLIENT_ID="your-dev-dashboard-client-id-here"
# SHOPIFY_CLIENT_SECRET="your-dev-dashboard-client-secret-here"
# SHOPIFY_ADMIN_ACCESS_TOKEN="shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" # Alternative to client credentials; needs write_products, write_publications, write_files and write_online_store_pages.
# DRY_RUN="1" # With `pnpm seed:catalog`, `pnpm import:catalog`, or `pnpm seed:content`, print what would be written and exit.
# SHOPIFY_PUBLICATION_ID="gid://shopify/Publication/123456789" # Optional override for the Headless publication; otherwise the seeder matches one by name.
# UNPUBLISH_OTHERS="1" # With `pnpm seed:catalog` or `pnpm import:catalog`, unpublish products and collections that are not in the seeded catalog.
# SHOPIFY_WEBHOOK_SECRET="your-shopify-webhook-secret-here"
# UCP_AGENT_PROFILE_URL="https://your-agent.example.com/agent/ucp-profile.json" # Optional override for the profile URL sent to Shopify catalog search; leave unset to use <site>/agent/ucp-profile.json.

# EVE_DEV="1" # Set by Eve's dev server; the agent profile uses Shopify's public example for EVE_DEV, preview deployments, and localhost. UCP_AGENT_PROFILE_URL overrides it.
# VERCEL_ENV is provided by Vercel; previews use Shopify's public example agent profile.

# Seed script switches.
# UPDATE="1" # With `pnpm seed:content`, replace existing page and article bodies from scripts/content/.
# UPLOAD_IMAGES="0" # With `pnpm seed:content`, keep local image paths instead of uploading to Shopify Files.

# V0_CALLBACK_URL="https://your-v0-preview-callback-here" # Set by the v0 preview environment only; it disables Next image optimization. Do not set it in production.

# Playwright verification. The design tests default to the local dev server.
# DESIGN_BASE_URL="http://localhost:3000" # Override the storefront under test for `pnpm test:design`.
# CLONE_URL="http://localhost:3000" # Override the clone side of `pnpm audit:reference`.
# REFERENCE_URL="https://politesocietyshop.com" # Override the live reference side of `pnpm audit:reference`.
